# LUMIERE JEWELLERY - example environment file.
# Copy this to `.env` (or `.env.local`) and fill in your values.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Base URL of the REST API (products, categories, orders, admin, settings…).
VITE_API_URL=http://localhost:4000/api

# Base URL for account endpoints. The backend exposes POST {VITE_AUTH_ENDPOINT}/register
# and POST {VITE_AUTH_ENDPOINT}/login, each answering with { "user": {...}, "token": "..." }.
# When unset, the register/login page falls back to a front-end-only on-device demo store.
VITE_AUTH_ENDPOINT=http://localhost:4000/api/auth

# POST endpoint that receives contact-form submissions (JSON body).
VITE_CONTACT_ENDPOINT=http://localhost:4000/api/contact

# POST endpoint that receives newsletter subscriptions ({ "email": "..." }).
VITE_NEWSLETTER_ENDPOINT=http://localhost:4000/api/newsletter

# POST endpoint that starts checkout with the current cart ({ "items": [...] }).
# May answer with { "url": "..." } to redirect to a payment page.
VITE_CHECKOUT_ENDPOINT=http://localhost:4000/api/checkout
