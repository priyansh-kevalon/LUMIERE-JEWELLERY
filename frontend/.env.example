# LUMIERE JEWELLERY - example environment file.
# Copy this to `.env` (or `.env.local`) and fill in your values.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# POST endpoint that receives contact-form submissions (JSON body).
VITE_CONTACT_ENDPOINT=https://api.example.com/contact

# POST endpoint that receives newsletter subscriptions ({ "email": "..." }).
VITE_NEWSLETTER_ENDPOINT=https://api.example.com/newsletter

# Base URL for account endpoints. When unset, the register/login page falls
# back to a front-end-only, on-device demo store. The backend should expose
# POST {VITE_AUTH_ENDPOINT}/register and POST {VITE_AUTH_ENDPOINT}/login, each
# answering with { "user": { "name", "email" }, "token": "..." }.
VITE_AUTH_ENDPOINT=https://api.example.com/auth

# POST endpoint that starts checkout with the current cart ({ "items": [...] }).
# When unset, the Product Detail "Buy Now" action adds the piece to the bag and
# reports that checkout is not connected instead of faking a purchase. When set,
# the endpoint may answer with { "url": "..." } to redirect to a payment page.
VITE_CHECKOUT_ENDPOINT=https://api.example.com/checkout
