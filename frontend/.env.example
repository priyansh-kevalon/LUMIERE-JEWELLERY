# LUMIERE JEWELLERY — example environment file (frontend / Vite).
# Copy this to `.env` (or `.env.local`) for local development, then adjust.
# Only variables prefixed with VITE_ are exposed to the client bundle.
#
# In production (e.g. a Render static site) do NOT rely on a `.env` file — set
# VITE_API_URL in the Render dashboard instead. It is the ONLY variable the app
# needs.
#
# IMPORTANT: do NOT define per-feature endpoints (VITE_AUTH_ENDPOINT,
# VITE_CHECKOUT_ENDPOINT, …). They are no longer supported and, worse, a
# localhost value gets baked into the production bundle, causing the deployed
# site to fail with "Failed to fetch". Every endpoint is derived automatically:
#   auth       -> {VITE_API_URL}/auth
#   contact    -> {VITE_API_URL}/contact
#   newsletter -> {VITE_API_URL}/newsletter
#   checkout   -> {VITE_API_URL}/checkout

# Base URL of the REST API, INCLUDING the `/api` prefix (the backend mounts
# every route under `/api`). In production set this to the deployed backend,
# e.g. https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:4000/api
