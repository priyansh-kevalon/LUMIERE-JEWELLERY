# LUMIERE JEWELLERY — example environment file (frontend / Vite).
# Copy this to `.env` (or `.env.local`) for local development, then adjust.
# Only variables prefixed with VITE_ are exposed to the client bundle.
#
# In production (e.g. a Render static site) do NOT ship a `.env` file — set
# the variables in the Render dashboard instead. Only VITE_API_URL is
# required; the optional overrides below normally fall back to
# `{VITE_API_URL}/<feature>`.

# Base URL of the REST API, INCLUDING the `/api` prefix (the backend mounts
# every route under `/api`). Point this at the deployed backend in production,
# e.g. https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:4000/api

# ── Optional per-feature overrides ──────────────────────────────────────
# Leave these commented out unless an endpoint lives somewhere other than the
# API base. The app derives them automatically from VITE_API_URL:
#   auth       -> {VITE_API_URL}/auth
#   contact    -> {VITE_API_URL}/contact
#   newsletter -> {VITE_API_URL}/newsletter
#   checkout   -> {VITE_API_URL}/checkout
# VITE_AUTH_ENDPOINT=https://your-backend.onrender.com/api/auth
# VITE_CONTACT_ENDPOINT=https://your-backend.onrender.com/api/contact
# VITE_NEWSLETTER_ENDPOINT=https://your-backend.onrender.com/api/newsletter
# VITE_CHECKOUT_ENDPOINT=https://your-backend.onrender.com/api/checkout
