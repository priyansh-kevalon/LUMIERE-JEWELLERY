# ─────────────────────────────────────────────────────────────────────────
#  LUMIÈRE JEWELLERY — backend environment (example)
#  Copy to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────────────────

# Your MongoDB connection string. Local or Atlas.
# Atlas passwords must be URL-encoded (e.g. @ -> %40).
MONGODB_URI=mongodb://127.0.0.1:27017/lumiere

NODE_ENV=development
PORT=4000

# Secret used to sign login tokens — set a long random string in production.
JWT_SECRET=change-me-lumiere-dev
JWT_EXPIRES_IN=7d

# Allowed browser origins (comma separated). List every origin that loads the
# frontend — local dev AND the deployed frontend URL.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Production example (add your deployed frontend origin):
# CORS_ORIGIN=http://localhost:5173,https://your-frontend.onrender.com

# ── Payments ─────────────────────────────────────────────────────────────
# Cash on delivery can be disabled by setting this to false.
COD_ENABLED=true
# Currency used for orders and Razorpay (INR for this store).
CURRENCY=INR

# Razorpay online payments (server-side only). Leave blank to disable online
# payment — the store then offers cash on delivery only.
# Use TEST keys while developing; switch to LIVE keys for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: set this only if you enable the Razorpay webhook
# (Dashboard → Settings → Webhooks → URL: <backend-url>/api/checkout/razorpay/webhook).
RAZORPAY_WEBHOOK_SECRET=
