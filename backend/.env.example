# ─────────────────────────────────────────────────────────────────────────
#  LUMIÈRE JEWELLERY — backend environment (example)
#  Copy to `.env` and fill in your values.
# ─────────────────────────────────────────────────────────────────────────

# Your MongoDB connection string. Local or Atlas.
# Atlas passwords must be URL-encoded (e.g. @ -> %40).
MONGODB_URI=mongodb://127.0.0.1:27017/lumiere

NODE_ENV=development
PORT=4000

# Secret used to sign login tokens — set a long random string in production.
JWT_SECRET=change-me-lumiere-dev
JWT_EXPIRES_IN=7d

# Allowed browser origins (comma separated).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
